{
  "name": "bricklink-api",
  "version": "3.0.0",
  "description": "A node module for connecting to the Bricklink API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryansh100/bricklink-api.git"
  },
  "keywords": [
    "node",
    "js",
    "javascript",
    "module",
    "bricklink",
    "api",
    "oauth2"
  ],
  "author": "Ryan Hafer",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ryansh100/bricklink-api/issues"
  },
  "homepage": "https://github.com/ryansh100/bricklink-api#readme",
  "scripts": {
    "test": "nyc ava",
    "test:ci": "nyc ava -c 1",
    "build": "npm run compile:src & npm run build:definitions",
    "compile:src": "babel src -d dist",
    "build:definitions": "tsc",
    "prepare": "husky install",
    "docs": "rimraf --glob docs/* & jsdoc -c .jsdoc.json",
    "prepublish": "npm run build",
    "report": "nyc report --reporter=html"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "@types/node": "^20.4.5",
    "@types/oauth": "^0.9.4",
    "ava": "^8.0.1",
    "dotenv": "^16.3.1",
    "husky": "^8.0.3",
    "jsdoc": "^4.0.2",
    "nyc": "^18.0.0",
    "prettier": "^3.0.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "oauth": "^0.10.2"
  },
  "ava": {
    "files": [
      "spec/**/*spec.js"
    ],
    "concurrency": 3,
    "failFast": true,
    "tap": true,
    "require": [
      "@babel/register"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "nyc": {
    "include": [
      "src/**/*"
    ]
  }
}
